// fastfetch — what is useful at a glance on this Mac (and the Pi): where am I on the network,
// is memory/disk tight, how loaded is it, how many agents/sessions are running.
// Docs: fastfetch --help <module>-format ; check: fastfetch -c ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "size": { "binaryPrefix": "jedec", "maxPrefix": "GB" },
    "percent": { "type": ["num", "bar"], "green": 60, "yellow": 85 },
    "bar": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "cpu", "key": "CPU", "temp": false },
    { "type": "loadavg", "key": "Load", "compact": true },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "command", "key": "Pressure", "text": "l=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null); case $l in 1) echo normal;; 2) echo 'WARN — close sessions/tabs';; 4) echo 'CRITICAL';; *) awk '/MemAvailable/{printf \"%.1f GB available\\n\", $2/1048576}' /proc/meminfo 2>/dev/null;; esac" },
    // one APFS container: "/" and the Data volume report the same space — show it once, with what is free
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage}) · free {size-free}" },
    "break",
    { "type": "localip", "key": "LAN IP", "showIpv4": true, "showIpv6": false, "showMac": false, "showPrefixLen": true, "showSpeed": true, "defaultRouteOnly": true },
    { "type": "command", "key": "Gateway", "text": "(route -n get default 2>/dev/null | awk '/gateway/{print $2}') || ip route show default 2>/dev/null | awk '{print $3; exit}'" },
    { "type": "dns", "key": "DNS", "showType": "ipv4" },
    { "type": "wifi", "key": "Wi-Fi" },
    { "type": "command", "key": "Hostname", "text": "h=$(scutil --get LocalHostName 2>/dev/null || hostname -s); echo \"$h.local\"" },
    { "type": "command", "key": "Tailscale", "text": "command -v tailscale >/dev/null && tailscale ip -4 2>/dev/null | head -1 || echo —" },
    "break",
    { "type": "command", "key": "Claude", "text": "ps -axo comm= | grep -cE '(^|/)(claude|2\\.[0-9]+\\.[0-9]+)$' | awk '{print $1\" sessions\"}'" },
    { "type": "command", "key": "tmux", "text": "tmux list-sessions -F '#S' 2>/dev/null | tr '\\n' ' ' || echo —" },
    { "type": "packages", "key": "Packages" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Display" },
    "break",
    "colors"
  ]
}
