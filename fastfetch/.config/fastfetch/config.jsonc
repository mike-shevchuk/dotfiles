// fastfetch defaults (same look as without a config) + a few lines: LAN IP, Wi-Fi, hostname for other devices
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // bar + number on every percentage line (memory, swap, disk, Wi-Fi): [ ■■■■■■■■■■-- ] 13.27 GB / 16.00 GB (83%)
  "display": {
    "percent": { "type": ["bar", "num"], "green": 60, "yellow": 85 },
    "bar": { "width": 12 },
    "size": { "binaryPrefix": "jedec" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "display",
    "de", "wm", "wmtheme", "theme", "icons", "font", "cursor", "terminal", "terminalfont",
    "cpu", "gpu", "memory", "swap", "disk",
    { "type": "localip", "showPrefixLen": false, "showSpeed": false, "defaultRouteOnly": true },
    "wifi",
    { "type": "command", "key": "Hostname", "text": "h=$(scutil --get LocalHostName 2>/dev/null || hostname -s); echo \"$h.local\"" },
    "battery", "poweradapter", "locale", "break", "colors"
  ]
}
