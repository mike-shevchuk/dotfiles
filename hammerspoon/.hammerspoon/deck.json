      { "label": "Close",    "icon": "close",   "action": { "keys": "cmd+w" } },
      { "label": "Prev tab", "icon": "left",    "action": { "keys": "cmd+shift+[" } },
      { "label": "Next tab", "icon": "right",   "action": { "keys": "cmd+shift+]" } },
      { "label": "Clear",    "icon": "trash",   "action": { "keys": "cmd+k" } },
      { "label": "Bigger",   "icon": "plus",    "action": { "keys": "cmd+=" } },
      { "label": "Smaller",  "icon": "minus",   "action": { "keys": "cmd+-" } },
      { "label": "Paste",    "icon": "paste",   "action": { "keys": "cmd+v" } }
    ],
    "Finder": [
      { "label": "→ JPG",    "icon": "image",   "action": { "convert": "jpg" } },
      { "label": "→ PNG",    "icon": "image",   "action": { "convert": "png" } },
      { "label": "→ PDF",    "icon": "file",    "action": { "convert": "pdf" } },
      { "label": "→ MP4",    "icon": "video",   "action": { "convert": "mp4" } },
      { "label": "→ MP3",    "icon": "audio",   "action": { "convert": "mp3" } },
      { "label": "New win",  "icon": "plus",    "action": { "keys": "cmd+n" } },
      { "label": "Downloads","icon": "download","action": { "keys": "cmd+alt+l" } },
      { "label": "Trash",    "icon": "trash",   "action": { "keys": "cmd+delete" } }
    ],
    "Code": [
      { "label": "Palette",  "icon": "bars",    "action": { "keys": "cmd+shift+p" } },
      { "label": "Open file","icon": "file",    "action": { "keys": "cmd+p" } },
      { "label": "Terminal", "icon": "keyboard","action": { "keys": "ctrl+`" } },
      { "label": "Search",   "icon": "eye",     "action": { "keys": "cmd+shift+f" } },
      { "label": "Format",   "icon": "edit",    "action": { "keys": "shift+alt+f" } },
      { "label": "Save",     "icon": "save",    "action": { "keys": "cmd+s" } },
      { "label": "Git",      "icon": "drive",   "action": { "keys": "ctrl+shift+g" } },
      { "label": "Close",    "icon": "close",   "action": { "keys": "cmd+w" } }
    ],
    "Obsidian": [
      { "label": "Quick",    "icon": "file",    "action": { "keys": "cmd+o" } },
      { "label": "New note", "icon": "plus",    "action": { "keys": "cmd+n" } },
      { "label": "Search",   "icon": "eye",     "action": { "keys": "cmd+shift+f" } },
      { "label": "Palette",  "icon": "bars",    "action": { "keys": "cmd+p" } },
      { "label": "Back",     "icon": "left",    "action": { "keys": "cmd+alt+left" } },
      { "label": "Forward",  "icon": "right",   "action": { "keys": "cmd+alt+right" } },
      { "label": "Graph",    "icon": "gps",     "action": { "keys": "cmd+g" } },
      { "label": "Close",    "icon": "close",   "action": { "keys": "cmd+w" } }
    ]
  }
