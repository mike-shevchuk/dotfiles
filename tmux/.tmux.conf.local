# -- .tmux.conf.local ----------------------------------------------------------
# Local overrides for gpakosz/.tmux base config
# Sourced automatically by .tmux.conf (line 156)


# -- Terminal features ---------------------------------------------------------

# Allow passthrough for image preview (yazi, kitty graphics protocol)
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# -- Clipboard over SSH (OSC 52) -----------------------------------------------
# This config frequently runs on a remote host (Mac server) reached over SSH
# from a local Wayland/Arch box. The base config (lines 122-131) and tmux-yank
# both pick a clipboard tool based on THIS host, so on the Mac they fall back to
# pbcopy and copied text lands in the *remote* clipboard — never reaching the
# local machine. OSC 52 fixes this transport-agnostically: tmux emits an escape
# sequence on every copy and the *local* terminal writes to its own clipboard,
# working through SSH regardless of what's installed on the remote host.
# Requires an OSC 52-capable local terminal (kitty, alacritty, wezterm, foot).
set -g set-clipboard on
set -ga terminal-features ',*:clipboard'

# prefix + y → copy top paste-buffer to the LOCAL clipboard via OSC 52.
# Overrides base .tmux.conf:128 which pipes to pbcopy = Mac-only clipboard —
# the exact failure mode the OSC 52 block above exists to fix.
# load-buffer -w (tmux 3.2+) re-loads the buffer and emits OSC 52 to the client.
bind y run -b 'tmux save-buffer - | tmux load-buffer -w -'

# prefix + Y → copy the pane's current path (kept from tmux-yank, which was
# removed — see plugin note below), OSC 52 via load-buffer -w.
bind Y run -b 'tmux display -p -F "#{q:pane_current_path}" | tr -d "\n" | tmux load-buffer -w -'

# -- Terminal quality ------------------------------------------------------------

# Pin tmux-256color: the base config's runtime probe silently degrades to
# screen-256color (no italics, worse keys) if a macOS update loses the
# terminfo entry. tmux 3.6b + modern terminals all have tmux-256color.
set -g default-terminal 'tmux-256color'

# REVERTED: extended-keys (CSI u / Kitty keyboard protocol) — enabling it
# caused real typing lag/misbehaving keys. The live client at the time
# reported termname xterm-256color; when the actual terminal doesn't fully
# implement CSI-u, tmux and the terminal disagree on key encoding and normal
# typing gets delayed/garbled. The upside (disambiguated Ctrl+Shift+…,
# Ctrl+Enter) isn't worth that risk — leave it off.
# set -s extended-keys on
# set -as terminal-features ',xterm*:extkeys,foot*:extkeys,alacritty*:extkeys,kitty*:extkeys'

# 5000-line default is a few seconds of Claude/log output; 50k is still cheap.
# (Applies to new panes only.)
set -g history-limit 50000

# Incremental copy-mode search — highlight-as-you-type instead of enter-then-jump
bind -T copy-mode-vi / command-prompt -i -T search -p '(search down)' { send-keys -X search-forward-incremental '%%' }
bind -T copy-mode-vi ? command-prompt -i -T search -p '(search up)'   { send-keys -X search-backward-incremental '%%' }

# -- TPM (Tmux Plugin Manager) ------------------------------------------------

# Auto-install TPM if missing
if "test ! -d ~/.tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm && ~/.tmux/plugins/tpm/bin/install_plugins'"

# Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'Ataraxy-Labs/opensessions'

# tmux-yank removed: on tmux 3.6b with `set-clipboard on` every buffer copy
# already emits OSC 52; the plugin only raced the gpakosz binding rewriter
# and left mixed pbcopy bindings. Its one used feature (prefix Y = copy pane
# pwd) is re-bound natively above.

# tmux-fingers — hint-based copy of URLs/paths/SHAs/IPs from scrollback
# (prefix + u). Copies go through the tmux buffer → OSC 52 delivers them to
# the LOCAL clipboard over SSH. ('u' was a duplicate TPM update-plugins key;
# 'U' still does that.)
set -g @plugin 'Morantron/tmux-fingers'
set -g @fingers-key 'u'

# Disabled: tmux-resurrect (session save/restore), tmux-continuum (auto-save)
# To re-enable, uncomment below:
# set -g @plugin 'tmux-plugins/tmux-resurrect'
# set -g @plugin 'tmux-plugins/tmux-continuum'
# set -g @resurrect-capture-pane-contents 'on'
# set -g @resurrect-strategy-nvim 'session'
# set -g @continuum-restore 'on'
# set -g @continuum-save-interval '15'


# -- Status bar (catppuccin-inspired, #!important overrides base theme) --------
#
# PERFORMANCE: every value shown here is read from a tmux user-option
# (#{@cpu}, #{@pane_git}, …) — ZERO subprocesses per redraw. Those options
# are refreshed by ~/.tmux-status.sh:
#   * refresh-global  — driven once per status-interval by a single empty-output
#     #() trigger embedded in status-left (sets @cpu @ram @claude @sessions …)
#   * refresh-pane    — driven by focus/select HOOKS only (sets @pane_git …)
# See the "Status refresh" hook block below.

set -g status 3 #!important
set -g status-position bottom #!important
set -g status-justify left #!important
set -g status-interval 5 #!important
set -g status-style 'bg=#1e1e2e fg=#cdd6f4' #!important

# Left (row 0): mode badge (recolors by prefix/copy/zoom) + session name + count.
# The trailing #() runs refresh-global once per interval (empty output).
set -g status-left-length 50 #!important
set -g status-left '#{?client_prefix,#[bg=#{@mode_color_prefix}],#{?pane_in_mode,#[bg=#{@mode_color_copy}],#{?window_zoomed_flag,#[bg=#{@mode_color_zoom}],#[bg=#{@mode_color_rest}]}}}#[fg=#1e1e2e,bold] #S #[bg=#1e1e2e] #[fg=#6c7086] #{@sessions} #(~/.tmux-status.sh refresh-global)#(~/dotfiles/tmux/scripts/fleet-sync.sh)' #!important

# Right (row 2): python | claude | cpu | ram | AWS | kubectl | time | date.
# All segments read cached user-options (no subprocess).
set -g status-right-length 200 #!important
set -g status-right '#[fg=#f9e2af]#{?#{@pane_python},🐍 #{@pane_python} ,}#[fg=#cba6f7]#{?#{@claude},󰚩 #{@claude} ,}#[fg=#94e2d5] #{@cpu} #[fg=#74c7ec] #{@ram} #[fg=#f9e2af]#{?#{@aws},  #{@aws} ,}#[fg=#a6e3a1]#{?#{@kube}, 󱃾 #{@kube} ,}#[fg=#cdd6f4]  %H:%M #[bg=#89b4fa,fg=#1e1e2e,bold]  %d-%b ' #!important

# Window list spans rows 0+1 so long names (emoji + worktree) stay readable.
# Split: windows 1..ceil(N/2) on row 0, the rest on row 1 (renumber-windows
# keeps indexes contiguous). Items mirror tmux's default status-format[0]
# (range=window → clickable, window-status-*-style colours, list=focus).
set -g @win_split '#{e|+:#{e|/:#{e|+:#{session_windows},1},2},#{e|-:#{base-index},1}}'
set -g @win_item '#[range=window|#{window_index} #{E:window-status-style}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-format}#[pop-default]#[norange default]'
set -g @win_item_cur '#[range=window|#{window_index} list=focus #{E:window-status-style} #{E:window-status-current-style}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-current-format}#[pop-default]#[norange list=on default]'
# Row 0: status-left + first half of windows.
set -g status-format[0] '#[align=left range=left #{E:status-left-style}]#[push-default]#{T;=/#{status-left-length}:status-left}#[pop-default]#[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{W:#{?#{e|<=:#{window_index},#{E:@win_split}},#{E:@win_item}#{?#{==:#{window_index},#{E:@win_split}},,#{E:window-status-separator}},},#{?#{e|<=:#{window_index},#{E:@win_split}},#{E:@win_item_cur}#{?#{==:#{window_index},#{E:@win_split}},,#{E:window-status-separator}},}}' #!important
# Row 1: second half of windows.
set -g status-format[1] '#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{W:#{?#{e|>:#{window_index},#{E:@win_split}},#{E:@win_item}#{?loop_last_flag,,#{E:window-status-separator}},},#{?#{e|>:#{window_index},#{E:@win_split}},#{E:@win_item_cur}#{?loop_last_flag,,#{E:window-status-separator}},}}' #!important

# Row 2 — Variant C: active-pane context (left) + status-right (right, moved
# off row 0 to give the window list room). Left-filled: git branch · PR (gh,
# cached) · compact path of the focused pane (python lives in status-right). Updated by the
# refresh-pane hooks, not every redraw.
set -g status-format[2] '#[bg=#1e1e2e]#[fg=#a6e3a1]#{?#{@pane_git}, 🌿 #{@pane_git} ,}#[fg=#fab387]#{?#{@pane_pr},#{@pane_pr} ,}#[fg=#89b4fa] #{@pane_path} #[nolist align=right range=right #{E:status-right-style}]#[push-default]#{T;=/#{status-right-length}:status-right}#[pop-default]#[norange default]' #!important

# Badges: 🙋 (red) = fleet.json need_mike (scripts/fleet-sync.sh sets
# @need_mike); ⏳/✋/✅ = @agent_state from Claude hooks (scripts/agent-state.sh).
# Window tabs — active tab is a filled block in the window's OWN colour
# (window-status-style fg + reverse) with ▶ ◀ markers; no fg switch inside
# the current format, or the block would change colour mid-tab.
set -g window-status-style 'fg=#6c7086' #!important
set -g window-status-current-style 'bold,reverse' #!important
set -g window-status-format ' #{?#{@need_mike},#[bg=#f38ba8 fg=#1e1e2e bold noreverse] 🙋 #[default] ,}#{?#{==:#{pane_current_command},claude},#[fg=#cba6f7]󰚩 ,}#{?#{==:#{@agent_state},working},⏳ ,#{?#{==:#{@agent_state},waiting},✋ ,#{?#{==:#{@agent_state},done},✅ ,}}}#{?#{@deploy},#{@deploy} ,}#I:#W ' #!important
set -g window-status-current-format ' #{?#{@need_mike},#[bg=#f38ba8 fg=#1e1e2e bold noreverse] 🙋 #[default] ,}▶ #{?#{==:#{pane_current_command},claude},󰚩 ,}#{?#{==:#{@agent_state},working},⏳ ,#{?#{==:#{@agent_state},waiting},✋ ,#{?#{==:#{@agent_state},done},✅ ,}}}#{?#{@deploy},#{@deploy} ,}#I:#W ◀ ' #!important
set -g window-status-separator '#[fg=#45475a,nobold,nounderscore] │ ' #!important

# -- Mode colors (native formats, no plugin) -----------------------------------
# Mode-reactive frame WITHOUT repainting the theme (replaces tubular-tmux,
# which took over status-left/right/tabs and killed the custom segments).
# Only two things change color by mode: the active-pane border and the
# status-left session badge. Everything else stays catppuccin.
# Switch palettes: prefix + S (fzf presets, applies live + rewrites the 5
# lines below) or `open ~/dotfiles/tmux/mode-theme-picker.html` for fully
# custom colors (tweak → copy the generated lines over the 5 below).
set -g @mode_color_prefix '#f38ba8'
set -g @mode_color_copy   '#f9e2af'
set -g @mode_color_zoom   '#fab387'
set -g @mode_color_claude '#cba6f7'
set -g @mode_color_rest   '#89b4fa'

# Pane borders — active border priority: prefix > copy > zoom > claude > rest
set -g pane-border-style 'fg=#313244' #!important
set -g pane-active-border-style '#{?client_prefix,fg=#{@mode_color_prefix},#{?pane_in_mode,fg=#{@mode_color_copy},#{?window_zoomed_flag,fg=#{@mode_color_zoom},#{?#{==:#{pane_current_command},claude},fg=#{@mode_color_claude},fg=#{@mode_color_rest}}}}}' #!important
# Light ASCII border (-|+) instead of solid box-drawing (─│┌┐) so the
# active pane reads as a non-solid underline rather than a heavy frame.
set -g pane-border-lines simple #!important
# Colour the corners of the active pane so it's still easy to spot.
set -g pane-border-indicators colour #!important
set -g pane-border-status top #!important
# ONE subprocess per visible pane (was ~4). pane-meta returns the whole
# pre-formatted string (claude state + uptime, or command, then path/git/python)
# with embedded #[...] styles, which tmux interprets in #() output.
set -g pane-border-format ' #(~/.tmux-status.sh pane-meta #{pane_id} "#{pane_current_path}") ' #!important

# Message style
set -g message-style 'bg=#313244 fg=#cdd6f4' #!important


# -- Status refresh (user-option cache, populated outside the redraw path) -----

# Active-pane context (@pane_git/@pane_python/@pane_path) — refreshed only on
# user navigation, never on the 5s redraw tick. -b keeps tmux non-blocking.
# CAVEAT: these are GLOBAL options. With two clients attached to different
# sessions, row 1 reflects whichever pane was focused last (tmux has no
# convenient per-client user-options). Correct for the common single-client case.
set-hook -g after-select-pane    'run-shell -b "~/.tmux-status.sh refresh-pane"'
set-hook -g after-select-window  'run-shell -b "~/.tmux-status.sh refresh-pane"'
set-hook -g pane-focus-in        'run-shell -b "~/.tmux-status.sh refresh-pane"'
set-hook -g session-window-changed 'run-shell -b "~/.tmux-status.sh refresh-pane"'
set-hook -g client-session-changed 'run-shell -b "~/.tmux-status.sh refresh-pane"'

# Populate both caches immediately on load so the bar isn't blank until the
# first interval / focus event fires.
run-shell -b "~/.tmux-status.sh refresh-global"
run-shell -b "~/.tmux-status.sh refresh-pane"


# -- DevOps layout bindings ----------------------------------------------------

# prefix + D → 3-pane devops layout (editor top, logs + shell bottom)
# (-l N% instead of deprecated -p N, tmux 3.1+)
bind D split-window -v -l 30% \; \
     split-window -h -l 50% \; \
     select-pane -t 0 \; \
     display "DevOps layout: editor | logs | shell"

# prefix + C-d → 4-pane quad layout for log tailing
bind C-d split-window -v -l 50% \; \
       split-window -h -l 50% \; \
       select-pane -t 0 \; \
       split-window -h -l 50% \; \
       select-pane -t 0 \; \
       display "Quad layout for log tailing"


# -- Claude Code layout --------------------------------------------------------

# prefix + C → 3-pane Claude Code layout (nvim top, claude + shell bottom)
bind C split-window -v -l 35% \; \
     split-window -h -p 50 \; \
     select-pane -t 1 \; \
     send-keys 'claude' Enter \; \
     select-pane -t 0 \; \
     display "Claude layout: nvim | claude code | shell"

# -- Popup windows (tmux 3.2+) ------------------------------------------------

# prefix + g → lazygit
bind g display-popup -E -w 85% -h 85% "lazygit"

# prefix + o → yazi file manager (new-window: display-popup lacks passthrough, see sxyazi/yazi#2308)
bind o new-window -n yazi "yazi"

# prefix + s → dotfiles stow status
bind s display-popup -E -w 60% -h 40% "just -f ~/dotfiles/justfile status; read -n1 -rp 'Press any key...'"

# prefix + T → tmux project switcher (ts — create/attach session from project dirs)
bind T display-popup -E -w 70% -h 60% "zsh -ic 'ts'"

# prefix + S → mode-color theme picker (fzf: presets or HTML custom picker;
# applies live and persists into this file — see scripts/theme-picker.sh).
# S = Style: verified unused by tmux defaults, the gpakosz base AND this file.
bind S display-popup -E -w 70% -h 60% "~/dotfiles/tmux/scripts/theme-picker.sh"

# prefix + j → session switcher (fzf list + live preview: windows/panes/git/claude)
bind j display-popup -E -w 70% -h 60% "~/dotfiles/tmux/scripts/session-switch.sh"

# prefix + n → window switcher, CURRENT session (fzf + live pane snapshot)
# prefix + N → window switcher, ALL sessions. hjkl left for panes.
# Fleet (data: ~/.claude/fleet-board/fleet.json, owned by the lead session).
# prefix 0 → lead window · prefix a → ⌨️mike window · prefix F → fleet board
# (F was fpp, not installed). Name-based: renumber-windows shifts indexes.
bind 0 select-window -t ':=lead'
bind a select-window -t ':*mike'
bind F display-popup -E -w 90% -h 70% "~/dotfiles/tmux/scripts/fleet-board.sh"

bind n display-popup -E -w 85% -h 75% "~/dotfiles/tmux/scripts/window-switch.sh"
bind N display-popup -E -w 85% -h 75% "~/dotfiles/tmux/scripts/window-switch.sh --all"

# prefix + B → btop system monitor
bind B display-popup -E -w 85% -h 85% "btop"

# prefix + G → lazygit on Branches view (compare current vs main: <space> on main)
bind G display-popup -E -w 90% -h 90% -d "#{pane_current_path}" "lazygit branch"

# ─── Diff/Compare popups (delegate to ~/dotfiles/tmux/scripts/git-compare.sh) ─
# EVERY binding starts with fzf branch picker (default branch pre-selected).
# Hit Enter for the common case; arrow/type to compare against another branch.

# prefix + v → DiffView (nvim side-by-side): single fzf picker for the branch to
# compare against (default = origin's default, e.g. origin/main — Enter picks it),
# then nvim opens DiffView with the WORKING TREE vs that branch.
# (lowercase v — pairs with V; uppercase U is TPM's update-plugins.)
bind v display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh diffview"

# prefix + V → CodeDiff (VSCode-style, C-powered, two-tier line+char highlighting).
# Same two-picker UX as prefix v: pick HEAD (default current) + BASE (default
# origin's default), diff BASE → HEAD (right side = WORKING TREE if HEAD = current).
# To use legacy DiffView instead: ~/dotfiles/tmux/scripts/git-compare.sh diffview
bind V display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh codediff"

# prefix + C-v → DIFF MENU: pick a platform (codediff / diffview / delta /
# difftastic / tig) via fzf, THEN the same HEAD + BASE two-picker, then launch
# the chosen viewer. Run the SAME comparison through different tools to find the
# one you like best. (C-v, not d — prefix d stays detach-client.)
bind C-v display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh menu"

# prefix + M → delta side-by-side pager vs picked branch (fallback if delta missing)
bind M display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh delta"

# prefix + X → difftastic semantic diff vs picked branch (fallback if difft missing; moved off N)
bind X display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh difftastic"

# prefix + O → pick branch → fzf list of changed files → open picked file in DiffView
bind O display-popup -E -w 95% -h 95% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/git-compare.sh files"


# -- Productivity popups (fzf/justfile-driven, scripts in tmux/scripts/) -------

# prefix + A → Claude dashboard: every pane running claude across all sessions,
#              with state / uptime / path / branch; Enter jumps to it.
bind A display-popup -E -w 85% -h 70% "~/dotfiles/tmux/scripts/claude-dashboard.sh"

# prefix + W → worktree session: git worktrees of the current repo → fzf →
#              create/attach a tmux session rooted in the chosen worktree.
bind W display-popup -E -w 80% -h 60% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/worktree-session.sh"

# prefix + R → just recipe runner: pick a recipe (global + project justfile),
#              doc-comment preview; Enter runs it in the popup.
bind R display-popup -E -w 80% -h 70% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/just-menu.sh"

# prefix + ? (or F1) → keybinding cheat-sheet for these custom bindings.
# Runs through `less -R`, so it scrolls with j/k · C-d/C-u · g/G · /search · q.
# F1 is the discoverable alias — '?' is easy to forget and needs Shift.
bind '?' display-popup -E -w 74% -h 82% "~/dotfiles/tmux/scripts/keys-help.sh"
bind F1  display-popup -E -w 74% -h 82% "~/dotfiles/tmux/scripts/keys-help.sh"

# -- Scroll the PANE without the mouse -----------------------------------------
# No prefix needed: these enter copy-mode for you, scroll, and (with `-e`) drop
# back to the shell automatically once you reach the bottom. The mouse wheel
# already does this (WheelUpPane → copy-mode -e); these are its keyboard twin.
#   Shift-PageUp / Shift-PageDown → one screen
#   Shift-Up     / Shift-Down     → three lines
#   Alt-Up       / Alt-Down       → three lines (same; kept as an alias)
# Inside copy-mode the usual keys keep working: j/k, C-u/C-d, g/G, /search, q.
#
# Shift+arrows are the PRIMARY line-scroll keys: macOS/SSH terminals often don't
# emit M-Up/M-Down at all (Option is eaten or sent as a composed char), while
# Shift+arrow is transmitted by everything that already sends Shift-PageUp.
# PLAIN PageUp / PageDown — no modifier at all, because some terminals (and SSH
# clients) never transmit modified arrows/pages: S-Up, M-Up and even S-PageUp
# can be swallowed before tmux ever sees them. A bare key always arrives.
# Guarded so it stays invisible to full-screen apps: inside nvim/less/fzf
# (alternate screen) or an already-open copy-mode the key is passed straight
# through to the program, so their own paging keeps working. Only at the shell
# prompt does it mean "scroll my scrollback".
# ONE line per press — the key auto-repeats while held, so holding it scrolls
# smoothly like a wheel instead of jumping.
#
# The guard is on `alternate_on` ONLY (a real full-screen app: nvim, less, fzf →
# the key belongs to them). It must NOT include `pane_in_mode`: passing the key
# through while copy-mode is already open handed it to copy-mode's own PageUp,
# which pages a whole screen — that was the "first press small, then it jumps"
# behaviour. Inside copy-mode we keep doing our own one-line scroll.
#
# tmux cannot show scrollback outside copy-mode, but `-e` leaves it the moment
# you reach the bottom again, so it never feels like a mode you're stuck in.
# Want a bigger step? change both `-N 1` values.
bind -n PPage if -F '#{alternate_on}' \
    { send-keys PPage } { copy-mode -e ; send-keys -X -N 1 scroll-up }
bind -n NPage if -F '#{alternate_on}' \
    { send-keys NPage } \
    { if -F '#{pane_in_mode}' { send-keys -X -N 1 scroll-down } { send-keys NPage } }

# prefix PgUp — same one-line scroll, but behind the prefix so it always works
# even on terminals/SSH clients that swallow the plain PageUp key.
bind PPage copy-mode -e \; send-keys -X -N 1 scroll-up

# Modified pages/arrows: same `alternate_on` guard as PPage/NPage above, so inside
# a full-screen app (nvim/less/fzf) the key is passed straight through instead of
# being hijacked into copy-mode (or, for the Down variants, silently swallowed).
bind -n S-PageUp   if -F '#{alternate_on}' { send-keys S-PageUp }   { copy-mode -eu }
bind -n S-PageDown if -F '#{alternate_on}' { send-keys S-PageDown } { if -F '#{pane_in_mode}' { send-keys -X page-down } { } }
bind -n S-Up       if -F '#{alternate_on}' { send-keys S-Up }       { copy-mode -e ; send-keys -X -N 3 scroll-up }
bind -n S-Down     if -F '#{alternate_on}' { send-keys S-Down }     { if -F '#{pane_in_mode}' { send-keys -X -N 3 scroll-down } { } }
bind -n M-Up       if -F '#{alternate_on}' { send-keys M-Up }       { copy-mode -e ; send-keys -X -N 3 scroll-up }
bind -n M-Down     if -F '#{alternate_on}' { send-keys M-Down }     { if -F '#{pane_in_mode}' { send-keys -X -N 3 scroll-down } { } }


# ── Seamless nvim <-> tmux pane nav (smart-splits.nvim aware) ────────────────
# C-hjkl moves between panes with NO prefix. If the focused pane runs (n)vim/fzf
# the key is forwarded so nvim's smart-splits handles it (move split, or cross
# back into tmux). In a plain/claude pane it moves the pane directly. This is
# the "fast switch nvim <-> Claude Code" — editor one side, claude the other.
is_vim="ps -o state= -o comm= -t '#{pane_tty}' 2>/dev/null | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|l?n?vim?x?|fzf)(diff)?$'"
bind -n C-h if-shell "$is_vim" 'send-keys C-h' 'select-pane -L'
# C-j/C-k are also forwarded to claude (newline / kill-to-EOL in its prompt);
# leave a claude pane vertically with prefix + arrow.
is_vim_claude="ps -o state= -o comm= -t '#{pane_tty}' 2>/dev/null | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?(g?(view|l?n?vim?x?|fzf)(diff)?|claude)$'"
bind -n C-j if-shell "$is_vim_claude" 'send-keys C-j' 'select-pane -D'
bind -n C-k if-shell "$is_vim_claude" 'send-keys C-k' 'select-pane -U'
bind -n C-l if-shell "$is_vim" 'send-keys C-l' 'select-pane -R'
# bare C-l used to clear-history; it's now pane-nav. Clear moved to prefix+C-k
# (prefix+C-h/C-l stay previous/next-window from ~/.tmux.conf; prefix+n is the switcher).
bind C-k send-keys C-l \; run 'sleep 0.2' \; clear-history

# ── prefix+w: pick a git worktree → new window [ nvim │ claude ] in it ────────
bind w display-popup -E -w 85% -h 75% -d "#{pane_current_path}" "~/dotfiles/tmux/scripts/wt-agent.sh"

# -- Initialize TPM (keep at bottom) ------------------------------------------

run '~/.tmux/plugins/tpm/tpm'
