# projctl — fleet launcher for all your tmux-based projects
#
#   just                    → TUI dashboard (TAB select · ↵ action · ESC quit)
#   just up                 → fzf picker to choose what to start (in a terminal)
#   just up all             → start every ENABLED project (same as login/auto-start)
#   just up [names…]        → start the named projects (even if disabled)
#   just down [names…]      → stop
#   just restart [names…]   → restart
#   just status             → status table (state · auto · ports)
#   just list               → show the registry
#
#   just add    <name> <dir> <session> [port] [extra]   → add, ENABLED at startup
#   just add-off <name> <dir> <session> [port] [extra]  → add, but manual-only
#   just enable  <name>     → include in `up all` / login
#   just disable <name>     → keep in list, but don't auto-start
#   just remove  <name>     → drop from the list entirely
#
#   just install / uninstall → auto-start on login (macOS launchd / Linux systemd)
#   DRY=1 just up            → dry-run: print what would happen, do nothing
#
# The project list lives in registry.conf (git-ignored — paths are machine-specific).
# Each project exposes the SAME interface `just start|stop|restart|status|logs` and
# runs inside a tmux session (see service.template.just).

set positional-arguments

_conf := justfile_directory() / "registry.conf"

# PATH prefix so just/tmux/docker resolve under a minimal login env (Mac vs Linux)
_path := if os() == "macos" {
  "/opt/homebrew/bin:/usr/local/bin:" + home_dir() / ".local/bin" + ":/usr/bin:/bin"
} else {
  "/usr/local/bin:/usr/bin:/bin:" + home_dir() / ".local/bin"
}

# TUI dashboard (default)
default: tui

# ─── TUI ──────────────────────────────────────────────────────────────────

# Interactive dashboard: TAB to select, ↵ to choose an action, ESC to quit
tui:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    JF="{{justfile()}}"
    if ! command -v fzf >/dev/null || ! command -v gum >/dev/null; then
      echo "TUI needs fzf and gum (brew install fzf gum). Falling back to status:" >&2
      exec just --justfile "$JF" status
    fi
    list=""
    while IFS='|' read -r name session port dir extra state enabled; do
      [ -z "$name" ] && continue
      if [ "$state" = up ]; then g="●"; else g="○"; fi
      [ "$enabled" = 1 ] && m=" " || m="✗"
      list+="$(printf '%s\t%s%s %-10s %s' "$name" "$m" "$g" "$name" "${port:+:$port}")"$'\n'
    done < <(just --justfile "$JF" _rows)
    [ -z "${list//[$'\n']/}" ] && { echo "registry empty — add a project: just add <name> <dir> <session> [port]" >&2; exit 0; }
    sel="$(printf '%s' "$list" | fzf --multi --delimiter='\t' --with-nth=2.. \
             --header='TAB select · ↵ action · ESC quit   (✗ = auto-start off)' \
             --height=95% --border --reverse --pointer='▶' --marker='✓' \
             --preview "just --justfile '$JF' _status-one {1}" \
             --preview-window=right,58%,border-left)" || exit 0
    names=()
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      names+=("${line%%$'\t'*}")
    done <<< "$sel"
    [ ${#names[@]} -eq 0 ] && { echo "→ nothing selected" >&2; exit 0; }
    action="$(printf '%s\n' start stop restart status logs attach enable disable remove \
      | gum choose --header "Action → ${names[*]}")" || exit 0
    case "$action" in
      logs|attach)          just --justfile "$JF" "$action" "${names[0]}" ;;
      enable|disable|remove) for n in "${names[@]}"; do just --justfile "$JF" "$action" "$n"; done ;;
      *)                    just --justfile "$JF" "$action" "${names[@]}" ;;
    esac

# ─── fleet actions ──────────────────────────────────────────────────────────

# Start projects. No args in a terminal → fzf picker; `all` → every ENABLED project
up *names:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    JF="{{justfile()}}"
    names="{{names}}"
    if [ "$names" = all ]; then names=""; fi
    if [ -z "$names" ] && [ -t 1 ] && command -v fzf >/dev/null; then
      names="$(just --justfile "$JF" _pick START)"
      if [ -z "${names// /}" ]; then echo "→ nothing selected" >&2; exit 0; fi
    fi
    exec just --justfile "$JF" _do "start" $names

# Start every ENABLED project without prompting (used by login/auto-start)
up-all: (_do "start" "")

# fzf multi-select of projects; prints chosen names (space-separated) to stdout
[private]
_pick verb:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    JF="{{justfile()}}"
    command -v fzf >/dev/null || { echo "fzf not installed (brew install fzf)" >&2; exit 1; }
    list=""
    while IFS='|' read -r name session port dir extra state enabled; do
      [ -z "$name" ] && continue
      if [ "$state" = up ]; then g="●"; else g="○"; fi
      [ "$enabled" = 1 ] && m=" " || m="✗"
      list+="$(printf '%s\t%s%s %-10s %s' "$name" "$m" "$g" "$name" "${port:+:$port}")"$'\n'
    done < <(just --justfile "$JF" _rows)
    sel="$(printf '%s' "$list" | fzf --multi --delimiter='\t' --with-nth=2.. \
             --header="pick projects to {{verb}} · TAB select · ↵ confirm · ESC cancel" \
             --height=90% --border --reverse --pointer='▶' --marker='✓' \
             --preview "just --justfile '$JF' _status-one {1}" \
             --preview-window=right,58%,border-left)" || exit 0
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      printf '%s ' "${line%%$'\t'*}"
    done <<< "$sel"

# Stop all projects (or the named ones)
down *names: (_do "stop" names)

# Restart all projects (or the named ones)
restart *names: (_do "restart" names)

[private]
_do action *names:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    want="{{names}}"
    rc=0
    [ -f "{{_conf}}" ] || { echo "registry empty — add a project: just add <name> <dir> <session> [port]" >&2; exit 0; }
    while IFS='|' read -r name dir session port extra enabled; do
      case "$name" in ''|\#*) continue ;; esac
      dir="${dir/#\~/$HOME}"
      if [ -n "$want" ]; then
        grep -qw -- "$name" <<<"$want" || continue
      elif [ "{{action}}" = start ] && [ "$enabled" != 1 ]; then
        continue
      fi
      echo "→ {{action}} $name" >&2
      if [ "${DRY:-0}" = 1 ]; then echo "   DRY: (cd $dir && just {{action}})" >&2; continue; fi
      if [ ! -d "$dir" ]; then echo "  FAIL (missing dir: $dir)" >&2; rc=1; continue; fi
      if ( cd "$dir" && just {{action}} ); then echo "  OK ({{action}} $name)" >&2
      else echo "  FAIL ({{action}} $name, exit $?)" >&2; rc=1; fi
    done < "{{_conf}}"
    exit $rc

# ─── registry editing ───────────────────────────────────────────────────────

# Add a project, ENABLED at startup:  just add <name> <dir> <session> [port] [extra]
add name dir session port="" extra="": (_add name dir session port extra "1")

# Add a project but manual-only (not started by `up all`/login)
add-off name dir session port="" extra="": (_add name dir session port extra "0")

[private]
_add name dir session port extra enabled:
    #!/usr/bin/env bash
    set -uo pipefail
    conf="{{_conf}}"; touch "$conf"
    if grep -q "^{{name}}|" "$conf"; then
      echo "  FAIL ({{name}} already in list — use enable/disable/remove)" >&2; exit 1
    fi
    printf '%s|%s|%s|%s|%s|%s\n' "{{name}}" "{{dir}}" "{{session}}" "{{port}}" "{{extra}}" "{{enabled}}" >> "$conf"
    if [ "{{enabled}}" = 1 ]; then st="enabled — starts on 'up all'/login"; else st="manual-only (not auto-started)"; fi
    echo "  OK (added {{name}}: $st)" >&2

# Include a project in `up all` / login
enable name: (_setflag name "1")

# Keep a project in the list but don't auto-start it
disable name: (_setflag name "0")

[private]
_setflag name flag:
    #!/usr/bin/env bash
    set -uo pipefail
    conf="{{_conf}}"
    [ -f "$conf" ] && grep -q "^{{name}}|" "$conf" || { echo "  FAIL (not in list: {{name}})" >&2; exit 1; }
    awk -F'|' -v OFS='|' -v n="{{name}}" -v f="{{flag}}" '
      /^#/ || NF<2 { print; next }
      $1==n { $6=f } { print }
    ' "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"
    if [ "{{flag}}" = 1 ]; then echo "  OK (enabled {{name}} — starts on 'up all'/login)" >&2
    else echo "  OK (disabled {{name}} — manual-only)" >&2; fi

# Drop a project from the list entirely
remove name:
    #!/usr/bin/env bash
    set -uo pipefail
    conf="{{_conf}}"
    [ -f "$conf" ] && grep -q "^{{name}}|" "$conf" || { echo "  FAIL (not in list: {{name}})" >&2; exit 1; }
    grep -v "^{{name}}|" "$conf" > "$conf.tmp" || true
    mv "$conf.tmp" "$conf"
    echo "  OK (removed {{name}})" >&2

# ─── status / list ──────────────────────────────────────────────────────────

# Status table: state · auto-start · port for every project
status:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    printf '%-10s %-8s %-6s %-8s %s\n' NAME STATE AUTO PORT DIR
    printf '%-10s %-8s %-6s %-8s %s\n' "──────────" "──────" "────" "──────" "───"
    just --justfile "{{justfile()}}" _rows | while IFS='|' read -r name session port dir extra state enabled; do
      [ "$state" = up ] && s="● up" || s="○ down"
      [ "$enabled" = 1 ] && a="yes" || a="no"
      printf '%-10s %-8s %-6s %-8s %s\n' "$name" "$s" "$a" "${port:+:$port}" "$dir"
    done

# Show the registry (with on/off auto-start marker)
list:
    #!/usr/bin/env bash
    export PATH="{{_path}}:$PATH"
    [ -f "{{_conf}}" ] || { echo "  (registry empty — just add <name> <dir> <session> [port])"; exit 0; }
    awk -F'|' '!/^#/ && NF>1 {printf "  %-10s %-5s → %s\n", $1, ($6=="1"?"[on] ":"[off]"), $2}' "{{_conf}}"

# ─── passthrough to a single project (uniform interface) ────────────────────

# Attach to a project's tmux session
attach name: (_one "attach" name)
# Tail a project's tmux output / logs
logs name: (_one "logs" name)

[private]
_one action name:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    [ -f "{{_conf}}" ] || { echo "registry empty" >&2; exit 1; }
    while IFS='|' read -r name dir session port extra enabled; do
      case "$name" in ''|\#*) continue ;; esac
      [ "$name" = "{{name}}" ] || continue
      dir="${dir/#\~/$HOME}"
      exec bash -c "cd '$dir' && just {{action}}"
    done < "{{_conf}}"
    echo "unknown project: {{name}}" >&2; exit 1

# ─── internals used by the TUI ──────────────────────────────────────────────

# emit: name|session|port|dir|extra|state|enabled   (state = up|down)
[private]
_rows:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    [ -f "{{_conf}}" ] || exit 0
    while IFS='|' read -r name dir session port extra enabled; do
      case "$name" in ''|\#*) continue ;; esac
      dir="${dir/#\~/$HOME}"
      if tmux has-session -t "$session" 2>/dev/null; then state=up; else state=down; fi
      printf '%s|%s|%s|%s|%s|%s|%s\n' "$name" "$session" "$port" "$dir" "$extra" "$state" "${enabled:-1}"
    done < "{{_conf}}"

# detailed status for one project (fzf preview)
[private]
_status-one target:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    [ -f "{{_conf}}" ] || { echo "registry empty"; exit 0; }
    while IFS='|' read -r name dir session port extra enabled; do
      case "$name" in ''|\#*) continue ;; esac
      [ "$name" = "{{target}}" ] || continue
      dir="${dir/#\~/$HOME}"
      echo "▌ $name"
      echo "  dir:       $dir"
      echo "  session:   $session"
      [ "$enabled" = 1 ] && echo "  auto-start: yes" || echo "  auto-start: no (manual-only)"
      if tmux has-session -t "$session" 2>/dev/null; then
        pid=$(tmux list-panes -t "$session" -F '#{pane_pid}' 2>/dev/null | head -1)
        echo "  state:     ● running (pid ${pid:-?})"
      else
        echo "  state:     ○ stopped"
      fi
      if [ -n "$port" ]; then
        if lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
          echo "  port:      :$port LISTEN"
        else
          echo "  port:      :$port (not listening)"
        fi
      fi
      for e in $extra; do
        if tmux has-session -t "$e" 2>/dev/null; then echo "  extra:     $e ●"; else echo "  extra:     $e ○"; fi
      done
      echo ""
      echo "  ── recent tmux output ──"
      tmux capture-pane -t "$session" -p -S -14 2>/dev/null | sed 's/^/  /' \
        || echo "  (session not running)"
      exit 0
    done < "{{_conf}}"
    echo "unknown project: {{target}}"

# ─── auto-start on login ────────────────────────────────────────────────────

# Enable auto-start on login (macOS → launchd, Linux → systemd)
install:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="{{_path}}:$PATH"
    DIR="{{justfile_directory()}}"
    case "{{os()}}" in
      macos)
        plist="$HOME/Library/LaunchAgents/com.mike.projctl.plist"
        echo "→ installing LaunchAgent (macOS)..." >&2
        cp "$DIR/com.mike.projctl.plist" "$plist"
        launchctl unload "$plist" 2>/dev/null || true
        launchctl load "$plist"
        echo "  OK (loaded $plist — projects start on next login)" >&2
        ;;
      linux)
        unit="$HOME/.config/systemd/user/projctl.service"
        echo "→ installing systemd user service (Linux)..." >&2
        mkdir -p "$(dirname "$unit")"
        cp "$DIR/projctl.service" "$unit"
        systemctl --user daemon-reload
        systemctl --user enable --now projctl.service
        loginctl enable-linger "$USER" 2>/dev/null \
          || echo "  (could not enable-linger; auto-start may need an active session)" >&2
        echo "  OK (enabled projctl.service)" >&2
        ;;
      *) echo "  FAIL (unsupported OS: {{os()}})" >&2; exit 1 ;;
    esac

# Disable auto-start on login
uninstall:
    #!/usr/bin/env bash
    set -uo pipefail
    export PATH="{{_path}}:$PATH"
    case "{{os()}}" in
      macos)
        plist="$HOME/Library/LaunchAgents/com.mike.projctl.plist"
        echo "→ removing LaunchAgent (macOS)..." >&2
        launchctl unload "$plist" 2>/dev/null || true
        rm -f "$plist"
        echo "  OK (removed)" >&2
        ;;
      linux)
        echo "→ removing systemd user service (Linux)..." >&2
        systemctl --user disable --now projctl.service 2>/dev/null || true
        rm -f "$HOME/.config/systemd/user/projctl.service"
        systemctl --user daemon-reload 2>/dev/null || true
        echo "  OK (removed)" >&2
        ;;
      *) echo "  FAIL (unsupported OS: {{os()}})" >&2; exit 1 ;;
    esac
