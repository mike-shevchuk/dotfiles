{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/danger-guard.ts"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh working || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/notification.ts --notify"
          },
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh waiting || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/stop.ts --chat"
          },
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/cost-logger.ts"
          },
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh done || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/subagent_stop.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.py) ruff check --fix \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/herdr-agent-state.sh; [ -f \"$f\" ] && bash \"$f\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh working || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "telegram@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-skills@ralph-marketplace": false,
    "ponytail@ponytail": true,
    "hookify@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "aws-serverless@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ralph-marketplace": {
      "source": {
        "source": "github",
        "repo": "snarktank/ralph"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
