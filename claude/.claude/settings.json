{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/blockers:~/.claude/mods/panes"
  },
  "permissions": {
    "allow": [
      "Bash(just --justfile justfile.v2 *-try*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null && exec bun ~/.claude/hooks/danger-guard.ts || exec npx tsx ~/.claude/hooks/danger-guard.ts"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh working || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null && exec bun ~/.claude/hooks/notification.ts --notify || exec npx tsx ~/.claude/hooks/notification.ts --notify"
          },
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh waiting || true"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/fleet-board/bin/tiki-live.sh ] && ~/.claude/fleet-board/bin/tiki-live.sh waiting || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null && exec bun ~/.claude/hooks/stop.ts --chat || exec npx tsx ~/.claude/hooks/stop.ts --chat"
          },
          {
            "type": "command",
            "command": "command -v bun >/dev/null && exec bun ~/.claude/hooks/cost-logger.ts || exec npx tsx ~/.claude/hooks/cost-logger.ts"
          },
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh done || true"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/fleet-board/bin/tiki-live.sh ] && ~/.claude/fleet-board/bin/tiki-live.sh done || true"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/fleet-board/bin/hook-tiki-sync.sh ] && ~/.claude/fleet-board/bin/hook-tiki-sync.sh || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null && exec bun ~/.claude/hooks/subagent_stop.ts || exec npx tsx ~/.claude/hooks/subagent_stop.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.py) ruff check --fix \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/herdr-agent-state.sh; [ -f \"$f\" ] && bash \"$f\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/handoff-inject.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/dotfiles/tmux/scripts/agent-state.sh ] && ~/dotfiles/tmux/scripts/agent-state.sh working || true"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/fleet-board/bin/tiki-live.sh ] && ~/.claude/fleet-board/bin/tiki-live.sh working || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "telegram@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-skills@ralph-marketplace": false,
    "ponytail@ponytail": true,
    "hookify@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "aws-serverless@claude-plugins-official": false,
    "task-observer@one-skill-to-rule-them-all": true,
    "arena-skill@arena-skill": true,
    "inline-images@claude-inline-images": true,
    "sdd@sdd": true,
    "show-your-work@iamumeransari": true
  },
  "extraKnownMarketplaces": {
    "ralph-marketplace": {
      "source": {
        "source": "github",
        "repo": "snarktank/ralph"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      }
    },
    "arena-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/arena-skill"
      }
    },
    "claude-inline-images": {
      "source": {
        "source": "github",
        "repo": "kbrianps/claude-inline-images"
      }
    },
    "sdd": {
      "source": {
        "source": "github",
        "repo": "genkovich/sdd"
      }
    },
    "iamumeransari": {
      "source": {
        "source": "git",
        "url": "https://github.com/iamumeransari/claude-show-your-work.git",
        "ref": "releases"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "switchModelsOnFlag": false,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Running rescue-serverless justfile try recipes (jb2b / just --justfile justfile.v2 <name>-try, including when wrapped in tmux/env -i/zsh -c) against the DEV environment is allowed, including creating and resolving test workflows, alerts/emergencies and device state in dev orgs (Test · Fixtures, Alex & Usama Band) - Mike approved 2026-10-16. Never applies to prod."
    ]
  },
  "voiceEnabled": true
}
